// Prisma schema for Baran Atay Hair Art appointment system
// Supports SQLite for development and PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Customer model - stores customer information
model Customer {
  id           String        @id @default(cuid())
  fullName     String
  email        String
  phone        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@index([email])
  @@index([phone])
}

// Staff model - stores staff/stylist information
model Staff {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@index([isActive])
}

// Service model - available services
model Service {
  id              String        @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int
  price           Float
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]

  @@index([isActive])
}

// Appointment status enum (stored as string in SQLite)
// PENDING: Initial state when created
// CONFIRMED: Confirmed by system/admin
// CANCELLED: Cancelled by customer or admin
// COMPLETED: Service has been completed

// Appointment model - stores appointment records
model Appointment {
  id           String   @id @default(cuid())
  customerId   String
  staffId      String
  serviceId    String
  date         DateTime // Date of the appointment
  startTime    String   // Time in HH:mm format
  endTime      String   // Calculated end time in HH:mm format
  status       String   @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  notes        String?
  reminderSent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([status])
  @@index([staffId, date])
  @@index([reminderSent])
}

// Contact form submissions
model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}
